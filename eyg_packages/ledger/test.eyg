let {assert} = import "../aok/index.eyg"
let ledger_package = import "./index.eyg"
let list = @standard.list
let string = @standard.string
let to_string = @standard.integer.to_string

let serve = (answer, run) -> {
  handle Fetch((request, resume) -> { resume(answer(request)) }, run)
}

let response = (status, body) -> {
  Ok({status, headers: [], body: !string_to_binary(body)})
}

let escaped = (json) -> { !string_replace(json, "\"", "\\\"") }

let entry = (chain, cid, sequence, payload) -> {
  string.concat([
    "{\"entity\":{\"/\":\"",
    chain,
    "\"},\"cid\":{\"/\":\"",
    cid,
    "\"},\"sequence\":",
    to_string(sequence),
    ",\"payload\":\"",
    escaped(payload),
    "\"}"
  ])
}

// The signatory is inside the payload, the entity of the entry is the chain.
let release = (chain, cid, sequence, signatory, package, version, module) -> {
  entry(chain, cid, sequence, string.concat([
    "{\"type\":\"release\",\"signatory\":{\"/\":\"",
    signatory,
    "\"},\"content\":{\"module\":{\"/\":\"",
    module,
    "\"},\"package\":\"",
    package,
    "\",\"version\":",
    to_string(version),
    "}}"
  ]))
}

let key_event = (chain, key) -> {
  entry(chain, chain, 1, string.concat([
    "{\"key\":\"",
    key,
    "\",\"type\":\"add_key\",\"content\":{\"key\":\"",
    key,
    "\"}}"
  ]))
}

let ledger_of = (entries) -> {
  string.concat(["{\"entries\":[", string.join(entries, ","), "]}"])
}

let packages_ledger = ledger_of([
  release("chain1", "chain1", 1, "sigA", "publishing", 1, "bafypub1"),
  release("chain1", "cid2", 2, "sigB", "other", 2, "bafyother2"),
  release("chain1", "cid3", 3, "sigA", "publishing", 3, "bafypub3")
])

let signatories_ledger = ledger_of([
  key_event("sigA", "KEYA"),
  key_event("sigB", "KEYB")
])

let both = (request) -> {
  match !equal(request.path, "/packages/pull") {
    True(_) -> { response(200, packages_ledger) }
    False(_) -> {
      match !equal(request.path, "/signatories/pull") {
        True(_) -> { response(200, signatories_ledger) }
        False(_) -> { response(404, "{}") }
      }
    }
  }
}

[
  {name: "ledger lists every release with its signatory",
   test: (_) -> {
     let found = serve(both, (_) -> { ledger_package.releases({}) })
     let rows = assert.ok(found)
     let _ = assert.equal(list.length(rows), 3)
     let {head} = assert.ok(!list_pop(rows))
     let _ = assert.equal_string(head.package, "publishing")
     assert.equal_string(head.signatory, "sigA")
   }},

  {name: "ledger lists the signatories the hub knows",
   test: (_) -> {
     let found = serve(both, (_) -> { ledger_package.signatories({}) })
     let rows = assert.ok(found)
     let _ = assert.equal(list.map(rows, ({key}) -> { key }), ["KEYA", "KEYB"])
     let _ =
       assert.equal(list.map(rows, ({signatory}) -> { signatory }), [
         "sigA",
         "sigB"
       ])
     assert.equal(list.map(rows, ({event}) -> { event }), [
       "add_key",
       "add_key"
     ])
   }},

  {name: "ledger keeps only the newest release of each package",
   test: (_) -> {
     let found = serve(both, (_) -> { ledger_package.packages({}) })
     let rows = assert.ok(found)
     let _ = assert.equal(list.length(rows), 2)
     let _ =
       assert.equal(list.map(rows, ({package}) -> { package }), [
         "publishing",
         "other"
       ])
     assert.equal(list.map(rows, ({version}) -> { version }), [3, 2])
   }},

  {name: "ledger lists every release of one package",
   test: (_) -> {
     let found = serve(both, (_) -> {
       ledger_package.history({package: "publishing"})
     })
     let rows = assert.ok(found)
     assert.equal(list.map(rows, ({version}) -> { version }), [1, 3])
   }},

  {name: "ledger knows the newest release of a package",
   test: (_) -> {
     let found = serve(both, (_) -> {
       ledger_package.latest({package: "publishing"})
     })
     let me = assert.ok(found)
     let _ = assert.equal_string(me.package, "publishing")
     let _ = assert.equal(me.version, 3)
     let _ = assert.equal_string(me.module, "bafypub3")
     assert.true(me.published)
   }},

  {name: "ledger reports a package as unpublished when it has no releases",
   test: (_) -> {
     let found = serve((_) -> { response(200, ledger_of([])) }, (_) -> {
       ledger_package.latest({package: "publishing"})
     })
     let me = assert.ok(found)
     let _ = assert.equal(me.version, 0)
     assert.false(me.published)
   }},

  {name: "ledger names who has released under a package, once each",
   test: (_) -> {
     let found = serve(both, (_) -> {
       ledger_package.publishers({package: "publishing"})
     })
     assert.equal(assert.ok(found), ["sigA"])
   }},

  {name: "ledger names nobody for a package with no releases",
   test: (_) -> {
     let found = serve(both, (_) -> {
       ledger_package.publishers({package: "nope"})
     })
     assert.equal(assert.ok(found), [])
   }},

  {name: "ledger reports a failed status with the path",
   test: (_) -> {
     let found = serve((_) -> { response(500, "") }, (_) -> {
       ledger_package.signatories({})
     })
     assert.equal_string(
       assert.error(found),
       "The hub returned HTTP 500 for /signatories/pull"
     )
   }},

  {name: "ledger passes a network failure through",
   test: (_) -> {
     let found = serve((_) -> { Error("network error") }, (_) -> {
       ledger_package.releases({})
     })
     assert.equal_string(assert.error(found), "network error")
   }},

  {name: "ledger reads the owner the hub records for a name",
   test: (_) -> {
     let found = serve(({path}) -> {
       match !equal(path, "/packages/example/owner") {
         True(_) -> {
           response(200, "{\"package\":\"example\",\"entity_id\":\"sigA\"}")
         }
         False(_) -> { response(404, "Not found") }
       }
     }, (_) -> { ledger_package.owner({package: "example"}) })
     match assert.ok(found) {
       Some(o) -> {
         let _ = assert.equal_string(o.package, "example")
         assert.equal_string(o.signatory, "sigA")
       }
       None(_) -> { perform Abort("expected an owner") }
     }
   }},

  {name: "ledger reports no owner for a name nobody has been granted",
   test: (_) -> {
     let found = serve((_) -> { response(404, "Not found") }, (_) -> {
       ledger_package.owner({package: "unclaimed"})
     })
     match assert.ok(found) {
       None(_) -> { {} }
       Some(_) -> { perform Abort("expected no owner") }
     }
   }},

  {name: "ledger reports a failure looking up an owner",
   test: (_) -> {
     let found = serve((_) -> { response(500, "") }, (_) -> {
       ledger_package.owner({package: "example"})
     })
     assert.equal_string(
       assert.error(found),
       "The hub returned HTTP 500 for the owner of example"
     )
   }},

  {name: "ledger builds the bytes of a first release",
   test: (_) -> {
     let bytes = ledger_package.entry({
       sequence: 1,
       previous: None({}),
       key: "KEYMATERIAL=",
       package: "example",
       version: 1,
       module: "bafyreigdmqpykrgxyahdnfmfzmc5j4bkwci6wf6fkdbapq7hfpmg2j3yqy",
       signatory: "baguqeera6p7ukm2pryu2ccbdgnlmuwdtnfd3ucpaefh3xdxyoytrrxptj2fa"
     })
     // exactly what the Gleam encoder produces for the same entry
     assert.equal_string(bytes, "{\"content\":{\"module\":{\"/\":\"bafyreigdmqpykrgxyahdnfmfzmc5j4bkwci6wf6fkdbapq7hfpmg2j3yqy\"},\"package\":\"example\",\"version\":1},\"key\":\"KEYMATERIAL=\",\"previous\":null,\"sequence\":1,\"signatory\":{\"/\":\"baguqeera6p7ukm2pryu2ccbdgnlmuwdtnfd3ucpaefh3xdxyoytrrxptj2fa\"},\"type\":\"release\"}")
   }},

  {name: "ledger builds the bytes of a release that follows another",
   test: (_) -> {
     let bytes = ledger_package.entry({
       sequence: 2,
       previous: Some("baguqeera6p7ukm2pryu2ccbdgnlmuwdtnfd3ucpaefh3xdxyoytrrxptj2fa"),
       key: "KEYMATERIAL=",
       package: "example",
       version: 2,
       module: "bafyreigdmqpykrgxyahdnfmfzmc5j4bkwci6wf6fkdbapq7hfpmg2j3yqy",
       signatory: "baguqeera6p7ukm2pryu2ccbdgnlmuwdtnfd3ucpaefh3xdxyoytrrxptj2fa"
     })
     assert.equal_string(bytes, "{\"content\":{\"module\":{\"/\":\"bafyreigdmqpykrgxyahdnfmfzmc5j4bkwci6wf6fkdbapq7hfpmg2j3yqy\"},\"package\":\"example\",\"version\":2},\"key\":\"KEYMATERIAL=\",\"previous\":{\"/\":\"baguqeera6p7ukm2pryu2ccbdgnlmuwdtnfd3ucpaefh3xdxyoytrrxptj2fa\"},\"sequence\":2,\"signatory\":{\"/\":\"baguqeera6p7ukm2pryu2ccbdgnlmuwdtnfd3ucpaefh3xdxyoytrrxptj2fa\"},\"type\":\"release\"}")
   }},

  {name: "ledger escapes a quote in a package name",
   test: (_) -> {
     let bytes = ledger_package.entry({
       sequence: 1,
       previous: None({}),
       key: "K",
       package: "a\"b",
       version: 1,
       module: "m",
       signatory: "s"
     })
     assert.true(!string_starts_with(bytes, "{\"content\":{\"module\":{\"/\":\"m\"},\"package\":\"a\\\"b\""))
   }},

  {name: "ledger works out what a new entry must carry",
   test: (_) -> {
     let found = serve(both, (_) -> { ledger_package.next({chain: "chain1"}) })
     let {sequence, previous} = assert.ok(found)
     let _ = assert.equal(sequence, 4)
     match previous {
       Some(cid) -> { assert.equal_string(cid, "cid3") }
       None(_) -> { perform Abort("expected a previous entry") }
     }
   }},

  {name: "ledger starts a chain that has nothing in it",
   test: (_) -> {
     let found = serve(both, (_) -> { ledger_package.next({chain: "fresh"}) })
     let {sequence, previous} = assert.ok(found)
     let _ = assert.equal(sequence, 1)
     match previous {
       None(_) -> { {} }
       Some(_) -> { perform Abort("expected no previous entry") }
     }
   }},

  {name: "ledger signs the entry and submits it",
   test: (_) -> {
     let signed = handle Sign((request, resume) -> {
       // the bytes signed are the entry, not the request
       let _ = assert.true(!string_starts_with(
         match !string_from_binary(request.data) {
           Ok(text) -> { text }
           Error(_) -> { "" }
         },
         "{\"content\":{\"module\":{\"/\":\"bafynew\"}"
       ))
       resume(Ok(!binary_from_integers([102, 111, 111, 98, 97, 114])))
     }, (_) -> {
       serve((request) -> {
         match !equal(request.path, "/packages/submit") {
           True(_) -> {
             // foobar in base32, the same encoding the hub decodes
             let _ = assert.contains(
               list.map(request.headers, ({key, value}) -> {
                 string.concat([key, ": ", value])
               }),
               "authorization: Signature MZXW6YTBOI======"
             )
             let _ = assert.contains(
               list.map(request.headers, ({key}) -> { key }),
               "content-type"
             )
             response(200, "{\"cursor\":9}")
           }
           False(_) -> { response(200, packages_ledger) }
         }
       }, (_) -> {
         ledger_package.publish({
           key: "unused by the test handler",
           key_id: "KEYMATERIAL=",
           signatory: "sigA",
           chain: "chain1",
           package: "publishing",
           module: "bafynew"
         })
       })
     })
     assert.equal_string(assert.ok(signed), "{\"cursor\":9}")
   }},

  {name: "ledger reports a release the hub refuses",
   test: (_) -> {
     let refused = handle Sign((_request, resume) -> {
       resume(Ok(!binary_from_integers([1])))
     }, (_) -> {
       serve((request) -> {
         match !equal(request.path, "/packages/submit") {
           True(_) -> { response(403, "not the owner") }
           False(_) -> { response(200, packages_ledger) }
         }
       }, (_) -> {
         ledger_package.publish({
           key: "k",
           key_id: "K",
           signatory: "sigA",
           chain: "chain1",
           package: "publishing",
           module: "bafynew"
         })
       })
     })
     assert.equal_string(
       assert.error(refused),
       "The hub refused the release, HTTP 403 not the owner"
     )
   }},

  {name: "ledger reaches a hub running on this machine over http",
   test: (_) -> {
     let local = ledger_package.http({host: "localhost", port: 8080})
     let found = serve((request) -> {
       let _ = match request.scheme {
         HTTP(_) -> { {} }
         HTTPS(_) -> { perform Abort("expected http") }
       }
       let _ = assert.equal_string(request.host, "localhost")
       let _ = match request.port {
         Some(port) -> { assert.equal(port, 8080) }
         None(_) -> { perform Abort("expected a port") }
       }
       response(200, packages_ledger)
     }, (_) -> { local.releases({}) })
     assert.equal(list.length(assert.ok(found)), 3)
   }},

  {name: "ledger reaches a public hub over https on the default port",
   test: (_) -> {
     let found = serve((request) -> {
       let _ = match request.scheme {
         HTTPS(_) -> { {} }
         HTTP(_) -> { perform Abort("expected https") }
       }
       let _ = assert.equal_string(request.host, "eyg.run")
       let _ = match request.port {
         None(_) -> { {} }
         Some(_) -> { perform Abort("expected no port") }
       }
       response(200, packages_ledger)
     }, (_) -> { ledger_package.releases({}) })
     assert.equal(list.length(assert.ok(found)), 3)
   }}
]
