// Check that env files, such as `.env.eyg` and `.env.work.eyg`, all have the same type.
// A config that imports one of them works with any of them.
//
//   eyg script eyg_packages/overlay/env.eyg .env.eyg .env.work.eyg
//
// Uses the `TypeCheck` effect, paths must be absolute or are resolved from the working directory.

let append = (a, b) -> {
  !string_append(a, b)
}

let read_text = (path) -> {
  match perform ReadFile({path, offset: 0, limit: 10000000}) {
    Ok(bytes) -> {
      match !string_from_binary(bytes) {
        Ok(text) -> { Ok(text) }
        Error(_) -> { Error(append(path, " is not valid utf-8")) }
      }
    }
    Error(reason) -> { Error(reason) }
  }
}

let type_of = (path) -> {
  match read_text(path) {
    Ok(code) -> {
      match perform TypeCheck(code) {
        Ok(type_) -> { Ok(type_) }
        Error(reason) -> { Error(append(path, append(": ", reason))) }
      }
    }
    Error(reason) -> { Error(append(path, append(": ", reason))) }
  }
}

// Ok with the shared type, or an error naming each file whose type differs from the first.
let check = (paths) -> {
  match !list_pop(paths) {
    Error(_) -> { Error("no env files given") }
    Ok({head, tail}) -> {
      match type_of(head) {
        Error(reason) -> { Error(reason) }
        Ok(expected) -> {
          let problems = !list_fold(tail, [], (path, problems) -> {
            match type_of(path) {
              Ok(type_) -> {
                match !equal(type_, expected) {
                  True(_) -> { problems }
                  False(_) -> { [append(path, append(" has type ", type_)), ..problems] }
                }
              }
              Error(reason) -> { [reason, ..problems] }
            }
          })
          match !list_pop(problems) {
            Error(_) -> { Ok(expected) }
            Ok(_) -> {
              let lines = !list_fold(problems, append(head, append(" has type ", expected)), (problem, acc) -> {
                append(acc, append("\n", problem))
              })
              Error(lines)
            }
          }
        }
      }
    }
  }
}

let absolute = (cwd, path) -> {
  match !string_starts_with(path, "/") {
    True(_) -> { path }
    False(_) -> { append(cwd, append("/", path)) }
  }
}

{
  check,
  script: (arguments) -> {
    let cwd = match perform CWD({}) {
      Ok(cwd) -> { cwd }
      Error(_) -> { "/" }
    }
    let paths = !list_fold(arguments, [], (path, acc) -> { [absolute(cwd, path), ..acc] })
    let paths = !list_fold(paths, [], (path, acc) -> { [path, ..acc] })
    match check(paths) {
      Ok(type_) -> {
        let _ = perform StandardOut(append("all env files have type ", append(type_, "\n")))
        0
      }
      Error(reason) -> {
        let _ = perform StandardOut(append(reason, "\n"))
        1
      }
    }
  }
}
