let readme = "# DNSimple

One function for each endpoint of the DNSimple API, named as DNSimple names the operation.
Each calls the API, the platform adds the token and the account id.
A function that takes no input is called with an empty record, `context.list_domains({})`.
Work on lists with `@standard`, `@standard.list.length`, `map`, `filter`, `fold` and the rest.
Answer with only what is asked, select the field of a record, `context.whoami({}).account.email` is the email address.

## Identity

- `whoami({})` is `{account: {id, email, plan}}`.

## Domains

- `list_domains({})` lists every domain, `{id, name, state, auto_renew, expires_at}`.
  `state` is \"registered\" or \"hosted\", `expires_at` is \"2027-03-15T00:00:00Z\" or \"\" when the domain is not registered.
- `get_domain(domain)` is one domain, by name or id.

## Zone records

A zone is a domain name. A record `{id, name, type, content, ttl, priority}` has the name \"\" for the zone itself
and \"www\" for www.example.com.

- `list_zone_records(zone)` lists the records of a zone.
- `get_zone_record(zone, record_id)` is one record.
- `create_zone_record(zone, attributes)` adds a record and returns it.
  `attributes` is `{name, type, content, ttl}`, a ttl of 3600 is one hour.
- `update_zone_record(zone, record_id, attributes)` changes a record and returns it.
- `delete_zone_record(zone, record_id)` removes a record.

## Registrar

- `check_domain(domain)` is `{domain, available, premium}` for a domain that might be registered.
- `get_domain_delegation(domain)` lists the name servers a registered domain is delegated to.
- `enable_domain_auto_renewal(domain)` and `disable_domain_auto_renewal(domain)` change whether a domain renews.

## Examples

```eyg
@standard.list.length(context.list_zone_records(\"example.com\"))
```

```eyg
@standard.list.filter(
  (record) -> { !equal(record.type, \"MX\") },
  context.list_zone_records(\"example.com\")
)
```

```eyg
@standard.list.map(context.list_zone_records(\"example.com\"), (record) -> { record.content })
```

```eyg
@standard.list.flat_map(context.list_domains({}), (domain) -> {
  context.list_zone_records(domain.name)
})
```

```eyg
context.create_zone_record(\"example.com\", {name: \"www\", type: \"A\", content: \"192.0.2.1\", ttl: 3600})
```

Changing or removing a record needs its id, so find it in the records of the zone first.

```eyg
@standard.list.map(
  @standard.list.filter(
    (record) -> { !equal(record.name, \"www\") },
    context.list_zone_records(\"example.com\")
  ),
  (record) -> { context.delete_zone_record(\"example.com\", record.id) }
)
```
"
let abort = (reason) -> { !never(perform Abort(reason)) }

// Decoding the JSON the API returns, the decoders are those of the `@json`
// package so that the context references no other module.

let move = (from, to) -> {
  !list_fold(from, to, (item, acc) -> { [item, ..acc] })
}

let take = (parsed) -> {
  match !list_pop(parsed) {
    Ok({head, tail}) -> { {head, tail} }
    Error(_) -> { abort("Unexpected end of JSON") }
  }
}

let drop = !fix((self, parsed, under) -> {
  match !list_pop(parsed) {
    Ok({head, tail}) -> {
      match !int_compare(head.depth, under) {
        Gt(_) -> { self(tail, under) }
        Eq(_) -> { parsed }
        Lt(_) -> { parsed }
      }
    }
    Error(_) -> { [] }
  }
})

let boolean = (parsed) -> {
  let {head, tail} = take(parsed)
  match head.term {
    True(_) -> { {value: True({}), rest: tail} }
    False(_) -> { {value: False({}), rest: tail} }
    | (_) -> { abort("Expected boolean") }
  }
}

let integer = (parsed) -> {
  let {head, tail} = take(parsed)
  match head.term {
    Integer(value) -> { {value, rest: tail} }
    Null(_) -> { {value: 0, rest: tail} }
    | (_) -> { abort("Expected integer") }
  }
}

let string = (parsed) -> {
  let {head, tail} = take(parsed)
  match head.term {
    String(value) -> { {value, rest: tail} }
    Null(_) -> { {value: "", rest: tail} }
    | (_) -> { abort("Expected string") }
  }
}

let list = (item_decoder) -> {
  (parsed) -> {
    let {head, tail} = take(parsed)
    match head.term {
      Array(_) -> {
        let under = head.depth
        let read_items = !fix((self, rest, acc) -> {
          match !list_pop(rest) {
            Ok({head, tail}) -> {
              match !int_compare(head.depth, under) {
                Gt(_) -> {
                  let decoded = item_decoder(rest)
                  self(decoded.rest, [decoded.value, ..acc])
                }
                Eq(_) -> { {value: move(acc, []), rest} }
                Lt(_) -> { {value: move(acc, []), rest} }
              }
            }
            Error(_) -> { {value: move(acc, []), rest} }
          }
        })
        read_items(tail, [])
      }
      | (_) -> { abort("Expected list") }
    }
  }
}

let do_field = !fix((self, parsed, at, seek) -> {
  match !list_pop(parsed) {
    Ok({head, tail}) -> {
      match !int_compare(head.depth, at) {
        Lt(_) -> { Error(seek) }
        Eq(_) -> {
          match head.term {
            Field(label) -> {
              match !equal(label, seek) {
                True(_) -> { Ok(tail) }
                False(_) -> { self(tail, at, seek) }
              }
            }
            | (_) -> { self(tail, at, seek) }
          }
        }
        Gt(_) -> { self(tail, at, seek) }
      }
    }
    Error(_) -> { Error(seek) }
  }
})

let field = (label, decoder) -> {
  (parsed) -> {
    let {head} = take(parsed)
    match do_field(parsed, head.depth, label) {
      Ok(rest) -> { decoder(rest).value }
      Error(_) -> { abort(!string_append("Missing field ", label)) }
    }
  }
}

let object = (decoder) -> {
  (parsed) -> {
    let {head, tail} = take(parsed)
    match head.term {
      Object(_) -> { {value: decoder(tail), rest: drop(tail, head.depth)} }
      | (_) -> { abort("Expected object") }
    }
  }
}

let parse = (body, decoder) -> {
  match perform DecodeJSON(body) {
    Ok(flat) -> {
      handle Abort(
        (message, _resume) -> { Error(message) },
        (_) -> { Ok(decoder(flat).value) }
      )
    }
    Error(reason) -> { Error(reason) }
  }
}

let data = (decoder) -> { object(field("data", decoder)) }

// Encoding request bodies.

let quote = (value) -> {
  let escaped = !string_replace(!string_replace(value, "\\", "\\\\"), "\"", "\\\"")
  !string_append("\"", !string_append(escaped, "\""))
}

let json_object = (pairs) -> {
  let joined = !list_fold(pairs, "", (pair, acc) -> {
    let entry = !string_append(!string_append(quote(pair.key), ":"), pair.value)
    match !equal(acc, "") {
      True(_) -> { entry }
      False(_) -> { !string_append(!string_append(acc, ","), entry) }
    }
  })
  !string_append("{", !string_append(joined, "}"))
}

// Calling the API.

let call = (method, path, query, body) -> {
  let operation = {
    method,
    path,
    query,
    headers: [
      {key: "accept", value: "application/json"},
      {key: "content-type", value: "application/json"}
    ],
    body: !string_to_binary(body)
  }
  match perform DNSimple(operation) {
    Ok(response) -> {
      match !int_compare(response.status, 400) {
        Lt(_) -> { response.body }
        | (_) -> {
          match parse(response.body, object(field("message", string))) {
            Ok(message) -> { abort(message) }
            Error(_) -> {
              abort(!string_append("DNSimple answered with status ", !int_to_string(response.status)))
            }
          }
        }
      }
    }
    Error(reason) -> { abort(reason) }
  }
}

let decoded = (body, decoder) -> {
  match parse(body, decoder) {
    Ok(value) -> { value }
    Error(reason) -> { abort(reason) }
  }
}

let get = (path, decoder) -> {
  decoded(call(GET({}), path, Some("per_page=100"), ""), decoder)
}


let whoami = (_) -> {
  get("/v2/whoami", data(object((fields) -> {
    {
      account: field("account", object((account) -> {
        {
          id: field("id", integer)(account),
          email: field("email", string)(account),
          plan: field("plan_identifier", string)(account)
        }
      }))(fields)
    }
  })))
}

let at = (suffix) -> {
  !string_append(!string_append("/v2/", !int_to_string(whoami({}).account.id)), suffix)
}

let domain_decoder = object((fields) -> {
  {
    id: field("id", integer)(fields),
    name: field("name", string)(fields),
    state: field("state", string)(fields),
    auto_renew: field("auto_renew", boolean)(fields),
    expires_at: field("expires_at", string)(fields)
  }
})

let list_domains = (_) -> { get(at("/domains"), data(list(domain_decoder))) }

let get_domain = (domain) -> {
  get(at(!string_append("/domains/", domain)), data(domain_decoder))
}

// Zone records.

let record_decoder = object((fields) -> {
  {
    id: field("id", integer)(fields),
    name: field("name", string)(fields),
    type: field("type", string)(fields),
    content: field("content", string)(fields),
    ttl: field("ttl", integer)(fields),
    priority: field("priority", integer)(fields)
  }
})

let records_path = (zone) -> {
  at(!string_append(!string_append("/zones/", zone), "/records"))
}

let record_path = (zone, record_id) -> {
  !string_append(!string_append(records_path(zone), "/"), !int_to_string(record_id))
}

let list_zone_records = (zone) -> {
  get(records_path(zone), data(list(record_decoder)))
}

let get_zone_record = (zone, record_id) -> {
  get(record_path(zone, record_id), data(record_decoder))
}

let attributes_body = (attributes) -> {
  json_object([
    {key: "name", value: quote(attributes.name)},
    {key: "type", value: quote(attributes.type)},
    {key: "content", value: quote(attributes.content)},
    {key: "ttl", value: !int_to_string(attributes.ttl)}
  ])
}

let create_zone_record = (zone, attributes) -> {
  let body = attributes_body(attributes)
  decoded(call(POST({}), records_path(zone), None({}), body), data(record_decoder))
}

let update_zone_record = (zone, record_id, attributes) -> {
  let body = attributes_body(attributes)
  decoded(
    call(PATCH({}), record_path(zone, record_id), None({}), body),
    data(record_decoder)
  )
}

let delete_zone_record = (zone, record_id) -> {
  let _ = call(DELETE({}), record_path(zone, record_id), None({}), "")
  {}
}

// Registrar.

let registrar = (domain, suffix) -> {
  at(!string_append(!string_append("/registrar/domains/", domain), suffix))
}

let check_domain = (domain) -> {
  get(registrar(domain, "/check"), data(object((fields) -> {
    {
      domain: field("domain", string)(fields),
      available: field("available", boolean)(fields),
      premium: field("premium", boolean)(fields)
    }
  })))
}

let get_domain_delegation = (domain) -> {
  get(registrar(domain, "/delegation"), data(list(string)))
}

let enable_domain_auto_renewal = (domain) -> {
  let _ = call(PUT({}), registrar(domain, "/auto_renewal"), None({}), "")
  {}
}

let disable_domain_auto_renewal = (domain) -> {
  let _ = call(DELETE({}), registrar(domain, "/auto_renewal"), None({}), "")
  {}
}

{
  readme,
  whoami,
  list_domains,
  get_domain,
  list_zone_records,
  get_zone_record,
  create_zone_record,
  update_zone_record,
  delete_zone_record,
  check_domain,
  get_domain_delegation,
  enable_domain_auto_renewal,
  disable_domain_auto_renewal
}
