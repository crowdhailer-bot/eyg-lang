// Print the name of every package the hub has, newest release first.
//
// Reading the hub is the ledger package, so this is only the printing.

let hub = @ledger:2:baguqeeragbnpxxmpvxfcteqaxyl24jy6ahbj4woat55begigh5tduvmgadsa
let list = @standard:1:baguqeerahlbgfg7wjjdjguypivmsdcvh3e2vs4lhiafdbbtl3duxfuzv2eja.list

match hub.packages({}) {
  Ok(found) -> {
    list.map(found, ({package}) -> {
      perform Print(!string_append(package, "\n"))
    })
  }
  Error(reason) -> { perform Abort(reason) }
}
