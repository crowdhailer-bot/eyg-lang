// Fetch a guide as markdown text from eyg.run.
let read = (slug) -> {
  let request = {
    method: GET({}),
    scheme: HTTPS({}),
    host: "eyg.run",
    port: None({}),
    path: !string_append("/guides/", !string_append(slug, ".md")),
    query: None({}),
    headers: [],
    body: !string_to_binary("")
  }
  match perform Fetch(request) {
    Ok({status, body}) -> {
      match !int_compare(status, 200) {
        Eq(_) -> {
          match !string_from_binary(body) {
            Ok(text) -> { Ok(text) }
            Error(_) -> { Error("the guide is not text") }
          }
        }
        | (_) -> { Error(!string_append("no guide with the slug ", slug)) }
      }
    }
    Error(reason) -> { Error(reason) }
  }
}

{index, read}
