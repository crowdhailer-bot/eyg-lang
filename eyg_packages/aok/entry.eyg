let aok = import "./index.eyg"
let original = import "./test.eyg"
let expectations = import "./expect_test.eyg"
let shallow = import "./shallow_test.eyg"
let reversed = !list_fold(original, [], (test, rest) -> { [test, ..rest] })
let expectations = !list_fold(!list_fold(expectations, [], (test, rest) -> { [test, ..rest] }), shallow,
  (test, rest) -> { [test, ..rest] })
let tests = !list_fold(reversed, expectations, (test, rest) -> { [test, ..rest] })

{
  tests,
  script: (_) -> {
    match !equal(aok.all(tests).failed, 0) {
      True(_) -> { 0 }
      False(_) -> { 1 }
    }
  }
}
