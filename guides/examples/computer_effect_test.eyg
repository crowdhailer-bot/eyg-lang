let {assert, expect, run_test} = import "../../eyg_packages/aok/index.eyg"

let greeting = (_) -> {
  let _ = perform StandardOut("Loading name\n")
  let bytes = assert.ok(perform ReadFile({path: "/fixtures/name.txt", offset: 0, limit: 100}))
  let name = assert.ok(!string_from_binary(bytes))
  let _ = perform StandardOut(!string_append("Hello ", !string_append(name, "\n")))
  name
}

run_test((_) -> {
  let name = expect.run(greeting, [
    expect.stdout((message) -> {
      let _ = assert.equal(message, "Loading name\n")
      {}
    }),
    expect.read_file(({path, offset, limit}) -> {
      let _ = assert.equal(path, "/fixtures/name.txt")
      let _ = assert.equal(offset, 0)
      let _ = assert.equal(limit, 100)
      Ok(!string_to_binary("Ada"))
    }),
    expect.stdout((message) -> {
      let _ = assert.equal(message, "Hello Ada\n")
      {}
    }),
  ])
  let _ = assert.equal(name, "Ada")
  {}
})
