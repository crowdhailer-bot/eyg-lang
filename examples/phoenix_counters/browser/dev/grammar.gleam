import gleam/json
import phoenix_counters_browser/grammar as embedded
import simplifile

const source = "../../../packages/vscode-eyg/syntaxes/eyg.tmLanguage.json"

pub fn check() {
  let assert Ok(data) = simplifile.read(source)
  assert data == embedded.data
    as "Grammar changed: run gleam run -m grammar before bundling"
}

pub fn main() {
  let assert Ok(data) = simplifile.read(source)
  let module =
    "//// Generated by gleam run -m grammar from packages/vscode-eyg.\n\npub const data = "
    <> json.to_string(json.string(data))
    <> "\n"
  let assert Ok(_) =
    simplifile.write("src/phoenix_counters_browser/grammar.gleam", module)
  Nil
}
