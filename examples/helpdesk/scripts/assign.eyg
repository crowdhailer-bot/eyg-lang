match perform SupportTicketOpen({subject: "My mouse won't click!"}) {
  Ok(ticket) -> {
    match perform SupportRepresentativeCreate({name: Some("Joe Armstrong")}) {
      Ok(representative) -> {
        perform SupportTicketAssign({id: ticket.id, representative_id: Some(representative.id)})
      }
      Error(reason) -> { Error(reason) }
    }
  }
  Error(reason) -> { Error(reason) }
}
